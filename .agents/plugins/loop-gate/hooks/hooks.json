{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(shell|developer__shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/gate-reviewed.sh",
            "timeout": 10,
            "on_failure": "block"
          }
        ]
      }
    ]
  }
}
