{
  "type": "object",
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "projection": {
      "type": "string",
      "const": "working-tree"
    },
    "scope": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "criteria": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "include",
        "exclude",
        "environment",
        "criteria"
      ],
      "additionalProperties": false
    },
    "git": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "head": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                }
              ]
            },
            "index": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755",
                      "120000"
                    ]
                  },
                  "blob": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                  }
                },
                "required": [
                  "path",
                  "mode",
                  "blob"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "head",
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "file"
              },
              "mode": {
                "type": "string",
                "pattern": "^[0-7]{4}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "kind",
              "mode",
              "sha256"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "symlink"
              },
              "mode": {
                "type": "string",
                "pattern": "^[0-7]{4}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "kind",
              "mode",
              "sha256",
              "target"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format_version",
    "root",
    "projection",
    "scope",
    "git",
    "entries",
    "candidate_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate identity v1"
}
